{
  "name": "local-chat",
  "version": "1.0.0",
  "description": "Browser-based virtual hangout space for local network events",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/smoke.test.js test/physics.test.js test/server.test.js",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=0 PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npx playwright test --config=playwright.config.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "playwright": "^1.60.0",
    "socket.io-client": "^4.8.3"
  }
}
